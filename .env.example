# ===============================================
# Plantilla de Variables de Entorno (NO SUBIR SECRETOS A GIT)
# Copia este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local
# ===============================================

# URL de tu servidor AdGuard Home (ej. http://192.168.1.100:80)
ADGUARD_URL=http://192.168.1.100

# Usuario administrador de AdGuard Home
ADGUARD_USERNAME=admin

# Contraseña de tu AdGuard Home
ADGUARD_PASSWORD=tu_contraseña_aqui

# Puerto en el que correrá la aplicación web (por defecto: 3000)
PORT=3000
